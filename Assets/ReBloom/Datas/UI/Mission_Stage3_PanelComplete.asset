  missionLabel: MISSION 2
  title: "\uBB3C\uACB0\uC774 \uC624\uB294 \uD0C0\uC774\uBC0D\uC744 \uB9DE\uCDB0\uB77C"
  hostdescription: "\uD154\uB808\uD3EC\uD130\uB97C \uD0C0\uACE0 Waterfront\uB85C
    \uC774\uB3D9\uD558\uC138\uC694.\n\uAC15 \uC591\uCABD\uC758 \uBC1C\uD310\uC5D0
    \uD55C \uBA85\uC529 \uC11C\uC138\uC694.\n\n\uBB3C\uACB0 \uD328\uD134\uC758 \uC18D\uB3C4\uAC00
    \uB290\uB824\uC9C0\uB294 \uD0C0\uC774\uBC0D\uC5D0 \uD2B8\uB9AC\uAC70 \uBC84\uD2BC\uC744
    \uB204\uB974\uC138\uC694.\n\uD0C0\uC774\uBC0D\uC744 \uC138 \uBC88 \uB9DE\uCD94\uBA74
    \uAC15\uBC14\uB2E5\uC5D0 \uBB3C\uC774 \uCC28\uC624\uB985\uB2C8\uB2E4. \n\uB2E8,
    \uC774 \uBB3C\uACB0\uC740 \uAC00\uC9DC \uBB3C\uACB0\uC77C \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. "
  clientdescription: "\uD154\uB808\uD3EC\uD130\uB97C \uD0C0\uACE0 Waterfront\uB85C
    \uC774\uB3D9\uD558\uC138\uC694.\n\uAC15 \uC591\uCABD\uC758 \uBC1C\uD310\uC5D0
    \uD55C \uBA85\uC529 \uC11C\uC138\uC694.\n\n\uC9C4\uB3D9\uC774 \uC810\uC810 \uAC15\uD574\uC9C0\uB2E4
    \uD53C\uD06C\uAC00 \uB418\uB294 \uD0C0\uC774\uBC0D\uC5D0 \uD2B8\uB9AC\uAC70 \uBC84\uD2BC\uC744
    \uB204\uB974\uC138\uC694. \n\uD0C0\uC774\uBC0D\uC744 \uC138 \uBC88 \uB9DE\uCD94\uBA74
    \uAC15\uBC14\uB2E5\uC5D0 \uBB3C\uC774 \uCC28\uC624\uB985\uB2C8\uB2E4. \n\uC9C4\uB3D9\uC774
    \uB290\uAEF4\uC9C0\uC9C0 \uC54A\uB294 \uBB3C\uACB0\uC740 \uAC00\uC9DC \uBB3C\uACB0\uC774\uBBC0\uB85C
    \uD2B8\uB9AC\uAC70\uB97C \uB204\uB97C \uD544\uC694\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.
    \uB8E8\uBA58\uC5D0\uAC8C \uBB3C\uACB0\uC758 \uAC00\uC9DC \uC5EC\uBD80\uB97C \uC54C\uB824
    \uC8FC\uC138\uC694."
