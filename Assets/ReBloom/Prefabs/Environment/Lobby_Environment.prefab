  buttonPressedColor: {r: 0.5294118, g: 0.5294118, b: 0.5294118, a: 1}
  msgRemember1: "\uCCB4\uB825\uC774 \uACE0\uAC08\uB418\uC5C8\uC2B5\uB2C8\uB2E4!\n\uCCAD\uAC01
    \uC81C\uC57D \uCE90\uB9AD\uD130\uB294 \uC7A0\uC2DC \uB3D9\uC548 \uC18C\uB9AC\uB97C
    \uB4E4\uC744 \uC218 \uC5C6\uACE0,\n\uC815\uC2E0 \uC81C\uC57D \uCE90\uB9AD\uD130\uB294\n\uB5A8\uC5B4\uC9C0\uB294
    \uB178\uD2B8\uAC00 \uBCF4\uC774\uC9C0 \uC54A\uAC8C \uB429\uB2C8\uB2E4."
  msgRemember2: "\uB450 \uCE90\uB9AD\uD130\uB294 \uD611\uB3D9\uD558\uBA70 \uBBF8\uC158\uC744
    \uD574\uACB0\uD574\uC57C \uD569\uB2C8\uB2E4."
  msgRemember3: "\uC815\uC2E0 \uC81C\uC57D \uCE90\uB9AD\uD130\uB294 \uB4E4\uB9AC\uB294
    \uC18C\uB9AC\uC758 \uBC15\uC790\uB97C\n\uCCAD\uAC01 \uC81C\uC57D \uCE90\uB9AD\uD130\uC5D0\uAC8C
    \uC804\uB2EC\uD574\uC8FC\uC138\uC694."
  msgListen: "\uB4E3\uAE30"
  msgReady: "\uC900\uBE44"
  msgPlay: "\uD50C\uB808\uC774"
  msgClear: "\uAC8C\uC784 \uD074\uB9AC\uC5B4!"
  msgWrong: "\uD2C0\uB838\uC2B5\uB2C8\uB2E4!"
