  m_Script: {fileID: 11500000, guid: 2c6c0e18e4e587a41b92bbcad0ce573b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionGuideBoard
  canvasGroup: {fileID: 1096814587045012565}
  kickerText: {fileID: 4411325463379464150}
  titleText: {fileID: 8350824544851073644}
  anchor: {fileID: 0}
  kicker: "MISSION 04 \xB7 \uC870\uC791 \uAC00\uC774\uB4DC"
  title: "\uB450 \uBC88\uC9F8 \uBFCC\uB9AC \xB7 \uB5A8\uC5B4\uC9C0\uB294 \uC78E"
  steps:
  - labelText: {fileID: 4521608000840698712}
    bodyText: {fileID: 3129873941610930132}
    iconImage: {fileID: 0}
    label: "01 \xB7 \uC2DC\uC791 \uBC84\uD2BC \uB204\uB974\uAE30"
    body: "\uBFCC\uB9AC \uC55E \uD328\uB110\uC758 \uC2DC\uC791 \uBC84\uD2BC\uC744
      \uB204\uB974\uC138\uC694.\n\uB5A8\uC5B4\uC9C0\uB294 \uC78E\uC744 \uC815\uD655\uD55C
      \uD0C0\uC774\uBC0D\uC5D0 \uC120\uD0DD\uD558\uB294 \uBBF8\uC158\uC774\uC5D0\uC694."
    icon: {fileID: 0}
  - labelText: {fileID: 6470999985743931651}
    bodyText: {fileID: 6979807212165350687}
    iconImage: {fileID: 0}
    label: "02 \xB7 \uBE68\uAC04 \uC120\uC5D0 \uB9DE\uCDB0 \uC120\uD0DD\uD558\uAE30"
    body: "\uB5A8\uC5B4\uC9C0\uB294 \uC78E\uC774 \uBE68\uAC04 \uC120\uC5D0 \uB2FF\uB294
      \uC21C\uAC04,\n\uC624\uB978\uC190 \uB808\uC774\uB85C \uC78E\uC744 \uACA8\uB204\uACE0
      \uD2B8\uB9AC\uAC70\uB97C \uB2F9\uAE30\uC138\uC694."
    icon: {fileID: 0}
  - labelText: {fileID: 3032534171882760199}
    bodyText: {fileID: 2790904870581514117}
    iconImage: {fileID: 0}
    label: "03 \xB7 \uD558\uB098\uB3C4 \uB193\uCE58\uC9C0 \uC54A\uAE30"
    body: "\uBE68\uAC04 \uC120\uC744 \uC9C0\uB098\uAC00\uB294 \uC78E\uC744 \uB193\uCE58\uC9C0
      \uB9C8\uC138\uC694.\n\uBAA8\uB4E0 \uC78E\uC744 \uC815\uD655\uD55C \uD0C0\uC774\uBC0D\uC5D0
      \uC120\uD0DD\uD574\uC57C \uD574\uC694."
    icon: {fileID: 0}
  footerText: {fileID: 3433049806125210663}
  footer: "\uC78E\uC744 \uBAA8\uB450 \uB9DE\uD788\uBA74 \uB2E4\uC74C \uBFCC\uB9AC\uB85C
    \uB118\uC5B4\uAC11\uB2C8\uB2E4."
  characterDisplay: 1
  lumenPortrait: {fileID: 9084153419334001451}
  echoPortrait: {fileID: 0}
  lumenNameText: {fileID: 3805649920555668198}
  echoNameText: {fileID: 0}
  lumenName: "\uB8E8\uBA58"
  echoName: "\uC5D0\uCF54"
  participationText: {fileID: 4322605982514683035}
  participationBoth: "\uB8E8\uBA58\uC774 \uB808\uC774\uB85C \uC78E\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4."
  participationLumenOnly: "\uB8E8\uBA58\uC774 \uB808\uC774\uB85C \uC78E\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4."
  participationEchoOnly: "\uB8E8\uBA58\uC774 \uB808\uC774\uB85C \uC78E\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4."
