  echoNameText: {fileID: 2513855505934863168}
  lumenName: "\uB8E8\uBA58"
  echoName: "\uC5D0\uCF54"
  participationText: {fileID: 1163118801356977169}
  participationBoth: "\uBFCC\uB9AC\uB294 \uC5D0\uCF54\uB9CC \uCC3E\uC744 \uC218 \uC788\uC5B4\uC694."
  participationLumenOnly: "\uB8E8\uBA58\uC774 \uB2F4\uB2F9\uD558\uB294 \uAD6C\uAC04\uC774\uC5D0\uC694."
