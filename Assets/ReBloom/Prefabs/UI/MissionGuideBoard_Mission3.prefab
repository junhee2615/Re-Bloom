  kickerText: {fileID: 1153519377865984363}
  titleText: {fileID: 3118902576207248031}
  anchor: {fileID: 0}
  kicker: "MISSION 03 \xB7 \uBBF8\uC158 \uD78C\uD2B8"
  title: "\uC0B4\uC544 \uC788\uB294 \uBFCC\uB9AC\uB97C \uCC3E\uC544\uB77C"
  steps:
  - labelText: {fileID: 9154628834698984044}
    bodyText: {fileID: 2781849923305600800}
    iconImage: {fileID: 0}
    label: "01 \xB7 \uAC89\uBAA8\uC2B5\uB9CC\uC73C\uB85C\uB294 \uC54C \uC218 \uC5C6\uC5B4\uC694"
    body: "\uC0B4\uC544 \uC788\uB294 \uBFCC\uB9AC\uC640 \uC8FD\uC740 \uADF8\uB8E8\uD130\uAE30\uB294
      \uAC89\uBAA8\uC2B5\uC774 \uBE44\uC2B7\uD574\uC694."
    icon: {fileID: 0}
  - labelText: {fileID: 1571946552983604817}
    bodyText: {fileID: 7385395255425841771}
    iconImage: {fileID: 0}
    label: "02 \xB7 \uBFCC\uB9AC\uC758 \uBC18\uC751\uC744 \uC0B4\uD3B4\uBCF4\uC138\uC694"
    body: "\uC5D0\uCF54\uAC00 \uADF8\uB8E8\uD130\uAE30\uC5D0 \uC190\uC744 \uB300\uBA74\n\uBFCC\uB9AC
      \uC8FC\uBCC0\uC5D0 \uB098\uD0C0\uB098\uB294 \uBCC0\uD654\uB97C \uD655\uC778\uD560
      \uC218 \uC788\uC5B4\uC694."
    icon: {fileID: 0}
  footerText: {fileID: 6279638707671814663}
  footer: "\uC138 \uAC1C\uB97C \uBAA8\uB450 \uCC3E\uC73C\uBA74 \uBFCC\uB9AC \uD65C\uC131\uD654\uAC00
    \uC2DC\uC791\uB429\uB2C8\uB2E4."
  characterDisplay: 0
