  m_Script: {fileID: 11500000, guid: 2c6c0e18e4e587a41b92bbcad0ce573b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionGuideBoard
  canvasGroup: {fileID: 3897601236974541713}
  kickerText: {fileID: 5790986453241681625}
  titleText: {fileID: 9072017076914527526}
  anchor: {fileID: 0}
  kicker: "MISSION 02 \xB7 \uBBF8\uC158 \uD78C\uD2B8"
  title: "\uC218\uC0DD\uC2DD\uBB3C\uC744 \uB418\uC0B4\uB824\uB77C"
  steps:
  - labelText: {fileID: 3061744380777949760}
    bodyText: {fileID: 4054355975267180584}
    iconImage: {fileID: 0}
    label: "01 \xB7 \uC11C\uB85C \uB2E4\uB978 \uC5ED\uD560"
    body: "\uC5D0\uCF54\uB294 \uC904\uAE30\uC5D0\uC11C \uB9AC\uB4EC\uC744 \uB290\uB084
      \uC218 \uC788\uACE0,\n\uB8E8\uBA58\uC740 \uAF43\uC78E\uC744 \uAE68\uC6B8 \uC218
      \uC788\uC5B4\uC694."
    icon: {fileID: 0}
  - labelText: {fileID: 7769259017635622686}
    bodyText: {fileID: 7951045793926825822}
    iconImage: {fileID: 0}
    label: "02 \xB7 \uB9AC\uB4EC\uC5D0 \uC9D1\uC911\uD558\uAE30"
    body: "\uB9AC\uB4EC\uC740 \uBC18\uBCF5\uB418\uB2C8 \uC11C\uB450\uB974\uC9C0 \uC54A\uC544\uB3C4
      \uAD1C\uCC2E\uC544\uC694.\n\uC11C\uB85C \uBC15\uC790\uB97C \uB9DE\uCDB0\uBCF4\uC138\uC694."
    icon: {fileID: 0}
  - labelText: {fileID: 143598361221939620}
    bodyText: {fileID: 4102426075112414493}
    iconImage: {fileID: 0}
    label: "03 \xB7 \uAC00\uBCCD\uAC8C \uB450\uB4DC\uB9AC\uAE30"
    body: "\uAF43\uC78E\uC740 \uBC84\uD2BC\uC744 \uB204\uB974\uC9C0 \uC54A\uACE0
      \uC0B4\uC9DD \uD130\uCE58\uD574\uB3C4 \uBC18\uC751\uD574\uC694."
    icon: {fileID: 0}
  footerText: {fileID: 7776626802669914973}
  footer: "\uC138 \uC1A1\uC774\uB97C \uBAA8\uB450 \uB418\uC0B4\uB9AC\uBA74 \uC5F0\uBABB\uC774
    \uAE68\uC5B4\uB0A9\uB2C8\uB2E4."
  characterDisplay: 0
  lumenPortrait: {fileID: 4324437910445826954}
  echoPortrait: {fileID: 7724126933919161500}
  lumenNameText: {fileID: 3789191466015089544}
  echoNameText: {fileID: 6798522281497065287}
  lumenName: "\uB8E8\uBA58"
  echoName: "\uC5D0\uCF54"
  participationText: {fileID: 5004343128708999931}
  participationBoth: "\uC5D0\uCF54\uC640 \uB8E8\uBA58\uC774 \uD568\uAED8 \uD574\uC57C
    \uD574\uC694."
  participationLumenOnly: "\uB8E8\uBA58\uC774 \uB2F4\uB2F9\uD558\uB294 \uAD6C\uAC04\uC774\uC5D0\uC694."
  participationEchoOnly: "\uC5D0\uCF54\uAC00 \uB2F4\uB2F9\uD558\uB294 \uAD6C\uAC04\uC774\uC5D0\uC694."
