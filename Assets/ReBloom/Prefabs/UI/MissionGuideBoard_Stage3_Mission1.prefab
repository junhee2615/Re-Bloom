  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c6c0e18e4e587a41b92bbcad0ce573b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionGuideBoard
  canvasGroup: {fileID: 6385768789335887367}
  kickerText: {fileID: 8174534202243286547}
  titleText: {fileID: 454524076881460043}
  anchor: {fileID: 0}
  kicker: "MISSION 01 \xB7 \uBBF8\uC158 \uD78C\uD2B8"
  title: "\uACE0\uC7A5 \uB09C \uD0DC\uC591\uAD11 \uD328\uB110\uC744 \uACE0\uCCD0\uB77C"
  steps:
  - labelText: {fileID: 6682987409134691734}
    bodyText: {fileID: 5615631289827767610}
    iconImage: {fileID: 0}
    label: "01 \xB7 \uC6C0\uC9C1\uC774\uB294 \uD328\uB110"
    body: "\uD328\uB110 \uC704\uC5D0\uC11C \uC55E\uB4A4\uB85C \uC6C0\uC9C1\uC774\uBA74\n\uBE5B\uC758
      \uBC29\uD5A5\uC744 \uBC14\uAFC0 \uC218 \uC788\uC5B4\uC694."
    icon: {fileID: 0}
  - labelText: {fileID: 7329996969799627537}
    bodyText: {fileID: 2134332447796294543}
    iconImage: {fileID: 0}
    label: "02 \xB7 \uC11C\uB85C \uB2E4\uB978 \uAC10\uAC01"
    body: "\uBE5B\uC904\uAE30\uB294 \uB8E8\uBA58\uC5D0\uAC8C\uB9CC \uBCF4\uC5EC\uC694.\n\uC5D0\uCF54\uAC00
      \uB290\uB07C\uB294 \uC9C4\uB3D9\uACFC \uD568\uAED8 \uD65C\uC6A9\uD574 \uBCF4\uC138\uC694."
    icon: {fileID: 0}
  - labelText: {fileID: 6609238249607156749}
    bodyText: {fileID: 23873030622797125}
    iconImage: {fileID: 0}
    label: "03 \xB7 \uBE5B\uC774 \uB2FF\uB294 \uBC29\uD5A5"
    body: "\uBE5B\uC774 \uB2FF\uB294\uB2E4\uACE0 \uBAA8\uB450 \uC218\uB9AC\uB418\uB294
      \uAC83\uC740 \uC544\uB2C8\uC5D0\uC694.\n\uD328\uB110\uC758 \uC5B4\uB290 \uBA74\uC744
      \uBE44\uCD94\uB294\uC9C0 \uC0B4\uD3B4\uBCF4\uC138\uC694."
    icon: {fileID: 0}
  footerText: {fileID: 2138610080673800559}
  footer: "\uACE0\uC7A5 \uB09C \uD0DC\uC591\uAD11 \uD328\uB110 4\uAC1C\uB97C \uBAA8\uB450
    \uC218\uB9AC\uD558\uC138\uC694."
  characterDisplay: 0
  lumenPortrait: {fileID: 3204108080194278113}
  echoPortrait: {fileID: 6321558468619841083}
  lumenNameText: {fileID: 2175397001785599511}
  echoNameText: {fileID: 3599218874407295052}
  lumenName: "\uB8E8\uBA58"
  echoName: "\uC5D0\uCF54"
  participationText: {fileID: 0}
  participationBoth: "\uB450 \uCE90\uB9AD\uD130 \uBAA8\uB450 \uCC38\uC5EC\uD560 \uC218
    \uC788\uC5B4\uC694."
  participationLumenOnly: "\uB8E8\uBA58\uC774 \uB2F4\uB2F9\uD558\uB294 \uAD6C\uAC04\uC774\uC5D0\uC694."
  participationEchoOnly: "\uC5D0\uCF54\uAC00 \uB2F4\uB2F9\uD558\uB294 \uAD6C\uAC04\uC774\uC5D0\uC694."
  visibleStep: 1
