--- !u!114 &2865567475315934083
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3102045228393453174}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c6c0e18e4e587a41b92bbcad0ce573b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionGuideBoard
  canvasGroup: {fileID: 1428673677001967384}
  kickerText: {fileID: 6607434290184209575}
  titleText: {fileID: 4195743882380827270}
  anchor: {fileID: 0}
  kicker: "MISSION 01 \xB7 \uC870\uC791 \uAC00\uC774\uB4DC"
  title: "\uC218\uB85C \uBCF5\uAD6C \uBC29\uBC95"
  steps:
  - labelText: {fileID: 1038276838813187521}
    bodyText: {fileID: 6041745850739817487}
    iconImage: {fileID: 0}
    label: "01 \xB7 \uB098\uBB47\uAC00\uC9C0 \uBF51\uAE30"
    body: "\uB098\uBB47\uAC00\uC9C0\uB97C Grab \uBC84\uD2BC\uC73C\uB85C \uC7A1\uACE0
      \uB2F9\uACA8\uC11C \uBF51\uC73C\uC138\uC694.\n\uBF51\uC740 \uB098\uBB47\uAC00\uC9C0\uB294
      \uBE5B\uB098\uB294 \uACBD\uACC4\uC120 \uBC16\uC73C\uB85C \uC62E\uAE30\uC138\uC694."
    icon: {fileID: 0}
  - labelText: {fileID: 8863992965556775107}
    bodyText: {fileID: 6539856734468787862}
    iconImage: {fileID: 0}
    label: "02 \xB7 \uBC14\uC704 \uC62E\uAE30\uAE30"
    body: "\uB8E8\uBA58\uACFC \uC5D0\uCF54\uAC00 \uD568\uAED8 \uBC14\uC704\uB97C
      \uC7A1\uC73C\uC138\uC694.\n\uB450 \uC0AC\uB78C\uC774 \uC7A1\uC73C\uBA74 \uC6C0\uC9C1\uC77C
      \uC218 \uC788\uC5B4\uC694.\n\uACBD\uACC4\uC120 \uBC16\uC73C\uB85C \uC62E\uAE30\uC138\uC694."
    icon: {fileID: 0}
  - labelText: {fileID: 8896765405004238006}
    bodyText: {fileID: 8368867242492660111}
    iconImage: {fileID: 0}
    label: "03 \xB7 \uD759\uB369\uC774 \uC81C\uAC70\uD558\uAE30"
    body: "\uD759\uC744 Grab\uC73C\uB85C \uC7A1\uC73C\uBA74 \uD55C \uC90C\uC774 \uB5A0\uC9C0\uACE0
      \uB369\uC774\uAC00 \uC791\uC544\uC838\uC694.\n\uC190\uC5D0 \uB4E0 \uD759\uC744
      \uB193\uACE0, \uD55C \uB369\uC774\uB2F9 3\uBC88 \uBC18\uBCF5\uD558\uC138\uC694."
    icon: {fileID: 0}
  footerText: {fileID: 1788486176395984815}
  footer: "\uBAA8\uB450 \uC81C\uAC70\uD558\uBA74 \uC218\uB85C\uAC00 \uBCF5\uAD6C\uB429\uB2C8\uB2E4."
  characterDisplay: 0
  lumenPortrait: {fileID: 696702042287790099}
  echoPortrait: {fileID: 7271371403188609028}
  lumenNameText: {fileID: 362453983523461046}
  echoNameText: {fileID: 2422183688191409338}
  lumenName: "\uB8E8\uBA58"
  echoName: "\uC5D0\uCF54"
  participationText: {fileID: 8360163252709405873}
  participationBoth: "\uB450 \uCE90\uB9AD\uD130 \uBAA8\uB450 \uCC38\uC5EC\uD560 \uC218
    \uC788\uC5B4\uC694."
  participationLumenOnly: "\uB8E8\uBA58\uC774 \uB2F4\uB2F9\uD558\uB294 \uAD6C\uAC04\uC774\uC5D0\uC694."
  participationEchoOnly: "\uC5D0\uCF54\uAC00 \uB2F4\uB2F9\uD558\uB294 \uAD6C\uAC04\uC774\uC5D0\uC694."
  visibleStep: 1
  hideDuringCutscene: 1
  distanceMode: 1
  showDistance: 3
  hideHysteresis: 0.25
