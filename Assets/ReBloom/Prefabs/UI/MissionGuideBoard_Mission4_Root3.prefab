    label: "01 \xB7 \uC2DC\uC791 \uBC84\uD2BC \uB204\uB974\uAE30"
    body: "\uBFCC\uB9AC \uC55E \uD328\uB110\uC758 \uC2DC\uC791 \uBC84\uD2BC\uC744
      \uB204\uB974\uC138\uC694.\n\uB458 \uC911 \uB204\uAC00 \uB20C\uB7EC\uB3C4 \uB429\uB2C8\uB2E4."
    icon: {fileID: 0}
  - labelText: {fileID: 8950065401423407328}
    bodyText: {fileID: 6291406464860977028}
    iconImage: {fileID: 0}
    label: "02 \xB7 1\uBD80 \u2014 \uB8E8\uBA58\uC774 \uB4E3\uACE0 \uC5D0\uCF54\uAC00
      \uB204\uB974\uAE30"
    body: "\uB9AC\uB4EC \uC18C\uB9AC\uB294 \uB8E8\uBA58\uC5D0\uAC8C\uB9CC \uB4E4\uB824\uC694.\n\uB8E8\uBA58\uC774
      \uBC15\uC790\uB97C \uC54C\uB824 \uC8FC\uBA74 \uC5D0\uCF54\uAC00 \uC624\uB978\uC190
      Grip\uC744 \uB204\uB974\uC138\uC694."
    icon: {fileID: 0}
  - labelText: {fileID: 2224692282133888830}
    bodyText: {fileID: 4162314339864295303}
    iconImage: {fileID: 0}
    label: "03 \xB7 2\uBD80 \u2014 \uC5D0\uCF54\uAC00 \uBCF4\uACE0 \uB8E8\uBA58\uC774
      \uC120\uD0DD\uD558\uAE30"
    body: "\uB5A8\uC5B4\uC9C0\uB294 \uC78E\uC740 \uC5D0\uCF54\uC5D0\uAC8C\uB9CC \uBCF4\uC5EC\uC694.\n\uC5D0\uCF54\uAC00
      \uBA87 \uBC88\uC9F8 \uC904\uC778\uC9C0 \uC54C\uB824 \uC8FC\uBA74\n\uB8E8\uBA58\uC774
      \uC624\uB978\uC190 \uB808\uC774\uB85C \uACA8\uB204\uACE0 \uD2B8\uB9AC\uAC70\uB97C
      \uB2F9\uAE30\uC138\uC694."
    icon: {fileID: 0}
  footerText: {fileID: 3008453404130348782}
  footer: "\uB450 \uB2E8\uACC4\uB97C \uBAA8\uB450 \uD1B5\uACFC\uD558\uBA74 \uBFCC\uB9AC
    \uD65C\uC131\uD654\uAC00 \uB05D\uB0A9\uB2C8\uB2E4."
