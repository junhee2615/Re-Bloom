    - target: {fileID: 7975535394796240033, guid: 6e70c9efcf279974fa65bb3d78bd8ea0, type: 3}
      propertyPath: msgNoteIntro
      value: "\uC5D0\uCF54\uB294 \uB178\uD2B8\uAC00 \uC120\uC5D0 \uB2FF\uC744 \uB54C\n\uB178\uD2B8\uAC00
        \uBA87 \uBC88 \uB808\uC778\uC5D0 \uC788\uB294\uC9C0 \uC54C\uB824\uC8FC\uC138\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 7975535394796240033, guid: 6e70c9efcf279974fa65bb3d78bd8ea0, type: 3}
      propertyPath: msgRemember1
      value: "\uCCB4\uB825\uC774 \uACE0\uAC08\uB418\uC5C8\uC2B5\uB2C8\uB2E4!\n\uC5D0\uCF54\uB294
        \uC7A0\uC2DC \uB3D9\uC548 \uC18C\uB9AC\uB97C \uB4E4\uC744 \uC218 \uC5C6\uACE0,\n\uB8E8\uBA58\uC740
        \uB5A8\uC5B4\uC9C0\uB294 \uB178\uD2B8\uAC00 \uBCF4\uC774\uC9C0 \uC54A\uAC8C
        \uB429\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7975535394796240033, guid: 6e70c9efcf279974fa65bb3d78bd8ea0, type: 3}
      propertyPath: msgRemember2
      value: "\uB450 \uD50C\uB808\uC774\uC5B4\uB294 \uD611\uB3D9\uD558\uBA70 \uBBF8\uC158\uC744
        \uD574\uACB0\uD574\uC57C \uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7975535394796240033, guid: 6e70c9efcf279974fa65bb3d78bd8ea0, type: 3}
      propertyPath: msgRemember3
      value: "\uB8E8\uBA58\uC740 \uB4E4\uB9AC\uB294 \uC18C\uB9AC\uC758 \uBC15\uC790\uB97C\n\uC5D0\uCF54\uC5D0\uAC8C
        \uC804\uB2EC\uD574\uC8FC\uC138\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 7988227428460936335, guid: 6e70c9efcf279974fa65bb3d78bd8ea0, type: 3}
